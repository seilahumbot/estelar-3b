# Porta do servidor backend
PORT=3333

# Banco de dados SQLite (não altere a menos que saiba o que está fazendo)
DATABASE_URL="file:./dev.db"

# Troque por uma string longa e aleatória antes de usar em produção
JWT_SECRET="troque_por_um_segredo_bem_grande_e_aleatorio"
JWT_EXPIRES_IN="7d"

# Provedor de IA: "demo" (padrão, não precisa de chave), "anthropic" ou "openai"
AI_PROVIDER="demo"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# URL do front-end, usada para liberar CORS
FRONTEND_URL="http://localhost:5173"
